# glslang upstream exports SPIRV under glslang/SPIRV for installed consumers.
file(COPY "${gz_glslang_SOURCE_DIR}/SPIRV" DESTINATION "${gz_glslang_BINARY_DIR}/glslang" FILES_MATCHING PATTERN "*.h")
target_include_directories(glslang INTERFACE "${gz_glslang_BINARY_DIR}")
