# AJM codecs, pinned to the same gitlinks as the reference. Keep downloads in build.
FetchContent_Declare(gz_atrac9 GIT_REPOSITORY https://github.com/shadps4-emu/ext-LibAtrac9.git GIT_TAG ec8899dadf393f655f2871a94e0fe4b3d6220c9a SOURCE_SUBDIR __gz_no_cmake__)
